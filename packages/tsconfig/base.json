{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "baseUrl": "../../",
        "paths": {
            "@listcollab/shared": [
                "packages/shared/src/index.ts"
            ]
        },
        "target": "ES2022",
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "skipLibCheck": true
    }
}