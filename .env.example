# Database host for local API and scripts
DB_HOST=db

# Database port for local API and scripts
DB_PORT=3306

# Database name used by Docker Compose and local scripts
DB_NAME=listcollab

# Application database user for local development
DB_USER=listcollab_user

# Application database password for local development
DB_PASSWORD=replace_with_generated_app_password

# MariaDB root password for local development
DB_ROOT_PASSWORD=replace_with_generated_root_password

# API origin allowed by CORS in local development
CORS_ORIGIN=http://localhost

# Host port for the production web container; keep the container bound to localhost behind a TLS reverse proxy
WEB_PORT=8080

# API logger level
LOG_LEVEL=info

# API runtime environment
NODE_ENV=production

# API port exposed inside the container
PORT=3002