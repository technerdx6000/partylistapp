# Application database password for local development
DB_PASSWORD=replace_with_generated_app_password

# MariaDB root password for local development
DB_ROOT_PASSWORD=replace_with_generated_root_password

# API origin allowed by CORS in local development
CORS_ORIGIN=http://localhost

# Host port for the production web container; keep the container bound to localhost behind a TLS reverse proxy
WEB_PORT=8080

# Shared image tag for both the API and web containers in the TrueNAS compose file
LISTCOLLAB_IMAGE_TAG=1.0.4

# Notes for the simplified TrueNAS compose:
# - appdata path is fixed to /mnt/tank/apps/appdata/listcollab
# - DB name is fixed to listcollab
# - DB user is fixed to listcollab_user
# - DB port is fixed to 3306
# - API port is fixed to 3002
# - image namespace is fixed to technerdx6000