{
  "name": "@listcollab/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4273 --strictPort",
    "build": "vite build",
    "type-check": "tsc -p tsconfig.json --noEmit",
