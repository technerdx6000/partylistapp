# API runtime environment
NODE_ENV=development

# API port for local development
PORT=3001

# Database host reachable by the API
DB_HOST=localhost

# Database port reachable by the API
DB_PORT=3306

# Database user for the API
DB_USER=listcollab_user

# Database password for the API
DB_PASSWORD=replace_with_generated_app_password

# Database name used by the API
DB_NAME=listcollab

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173