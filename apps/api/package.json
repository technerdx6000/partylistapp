{
  "name": "@listcollab/api",
  "private": true,
  "version": "1.0.0",
  "description": "API backend for Party List App",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "DB_HOST=127.0.0.1 PORT=4301 tsx watch server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --root ../.. --config vitest.config.ts --project api",
    "test:coverage": "vitest run --root ../.. --config vitest.config.ts --project api --coverage",
    "test:watch": "vitest --root ../.. --config vitest.config.ts --project api",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:rollback": "tsx src/db/rollback.ts"
  },
  "dependencies": {
    "@listcollab/shared": "1.0.0",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "helmet": "7.2.0",
    "mysql2": "3.14.5",
    "pino": "9.9.5",
    "umzug": "3.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/supertest": "6.0.3",
    "nodemon": "^3.0.2",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}