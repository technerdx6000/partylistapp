{
  "name": "@listcollab/api",
  "private": true,
  "version": "1.0.0",
  "description": "API backend for Party List App",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node scripts/db-migrate.js",
    "db:rollback": "node scripts/db-rollback.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mysql2": "^3.6.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "nodemon": "^3.0.2"
    ,"tsx": "4.20.5"
    ,"typescript": "5.9.2"
  }
}
